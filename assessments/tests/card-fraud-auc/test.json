{
  "id": "card-fraud-auc",
  "title": "Card Fraud Detection",
  "company": "Northwind Pay (fictional card issuer)",
  "framework": "Data Science Framework · Pandas + scikit-learn",
  "duration_minutes": 40,
  "duration_options": [40, 60, 75],
  "summary": "Imbalanced classification: clean card transactions, join card details, measure fraud rates, and rank May's transactions by fraud probability (ROC AUC).",
  "data_files": ["transactions_train.csv", "transactions_test.csv", "cards.csv"],
  "starter": "starter.ipynb",
  "task_html": "task.html",
  "submission": {
    "file": "submission.csv",
    "id_column": "tx_id",
    "prediction_column": "fraud_probability",
    "kind": "probability",
    "labels_file": "_hidden/test_labels.csv",
    "label_column": "is_fraud"
  },
  "tasks": [
    {"id": 1, "title": "Clean and profile", "points": 15,
     "checks": [
       {"var": "task1_fraud_rate", "kind": "number", "tol": 0.00015},
       {"var": "task1_n_cards", "kind": "number", "tol": 0},
       {"var": "task1_max_amount", "kind": "number", "tol": 0.011}
     ]},
    {"id": 2, "title": "Where fraud concentrates", "points": 20,
     "checks": [
       {"var": "task2_fraud_rate_by_channel", "kind": "dict", "tol": 0.00015},
       {"var": "task2_top_category", "kind": "string"},
       {"var": "task2_foreign_fraud_rate", "kind": "number", "tol": 0.00015}
     ]},
    {"id": 3, "title": "Score May's transactions", "points": 65, "model": true}
  ],
  "model": {"metric": "roc_auc", "floor": 0.80, "target": 0.90,
            "note": "0 points at ROC AUC 0.80 or below; full points at 0.90 or more; linear in between."}
}
